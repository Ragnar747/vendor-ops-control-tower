{
  "_about": "Data-quality rules. Each rule runs as one SQL query against the central database. severity: critical = blocks data sharing and exports until fixed; warning = reported and tracked, does not block. Rule types and their fields are documented in docs/DATA_GOVERNANCE.md.",
  "tables": {
    "trips": {"key": "trip_id"},
    "vendors": {"key": "vendor_id"},
    "vehicles": {"key": "vehicle_id"},
    "drivers": {"key": "driver_id"},
    "vendor_trip_logs": {"key": "trip_id"},
    "email_log": {"key": "message_id"}
  },
  "rules": [
    {"id": "TRP-001", "table": "trips", "type": "row_count_min", "min": 1, "severity": "critical",
     "description": "Trips table is not empty"},
    {"id": "TRP-002", "table": "trips", "type": "unique", "columns": ["trip_id"], "severity": "critical",
     "description": "Each trip appears once"},
    {"id": "TRP-003", "table": "trips", "type": "not_null", "column": "vendor_id", "severity": "critical",
     "description": "Every trip has a vendor"},
    {"id": "TRP-004", "table": "trips", "type": "foreign_key", "column": "vendor_id",
     "ref_table": "vendors", "ref_column": "vendor_id", "severity": "critical",
     "description": "Trip vendor exists in the vendor master"},
    {"id": "TRP-005", "table": "trips", "type": "allowed_values", "column": "status",
     "values": ["completed", "cancelled_by_vendor", "cancelled_by_rider"], "severity": "critical",
     "description": "Status is one of the three known values"},
    {"id": "TRP-006", "table": "trips", "type": "range", "column": "rating", "min": 1, "max": 5,
     "severity": "critical", "description": "Rating is between 1 and 5 (blank allowed)"},
    {"id": "TRP-007", "table": "trips", "type": "expression",
     "fail_when": "status = 'completed' AND (fare_inr IS NULL OR fare_inr <= 0 OR fare_inr > 50000)",
     "severity": "critical", "description": "Completed trips have a fare between Rs 1 and Rs 50,000"},
    {"id": "TRP-010", "table": "trips", "type": "expression",
     "fail_when": "status <> 'completed' AND fare_inr <> 0",
     "severity": "critical", "description": "Cancelled trips are not charged (fare is 0)"},
    {"id": "TRP-008", "table": "trips", "type": "expression",
     "fail_when": "scheduled_pickup < booked_at", "severity": "warning",
     "description": "Pickup is not scheduled before the booking was made"},
    {"id": "TRP-009", "table": "trips", "type": "not_future", "column": "trip_date", "severity": "critical",
     "description": "No trips dated after today"},
    {"id": "VEH-001", "table": "vehicles", "type": "not_null", "column": "registration_no", "severity": "critical",
     "description": "Every vehicle has a registration number"},
    {"id": "VEH-002", "table": "vehicles", "type": "foreign_key", "column": "vendor_id",
     "ref_table": "vendors", "ref_column": "vendor_id", "severity": "critical",
     "description": "Vehicle belongs to a known vendor"},
    {"id": "DRV-001", "table": "drivers", "type": "not_null", "column": "licence_expiry", "severity": "warning",
     "description": "Licence expiry date is recorded"},
    {"id": "CLM-001", "table": "vendor_trip_logs", "type": "pattern", "column": "trip_id", "glob": "T[0-9][0-9][0-9][0-9][0-9][0-9]",
     "severity": "warning", "description": "Claimed trip ID has the platform format T + 6 digits"},
    {"id": "CLM-002", "table": "vendor_trip_logs", "type": "range", "column": "claimed_fare_inr", "min": 1, "max": 50000,
     "severity": "warning", "description": "Claimed fare is positive and below Rs 50,000"},
    {"id": "CLM-003", "table": "vendor_trip_logs", "type": "unique", "columns": ["vendor_id", "trip_id"],
     "severity": "warning", "description": "A vendor claims each trip once"},
    {"id": "CLM-004", "table": "vendor_trip_logs", "type": "foreign_key", "column": "trip_id",
     "ref_table": "trips", "ref_column": "trip_id", "severity": "warning",
     "description": "Claimed trip exists on the platform"},
    {"id": "CLM-005", "table": "vendor_trip_logs", "type": "not_future", "column": "trip_date", "severity": "warning",
     "description": "Claimed trip date is not in the future"},
    {"id": "EML-001", "table": "email_log", "type": "allowed_values", "column": "status",
     "values": ["processed", "ignored_unknown_sender", "needs_manual_review"], "severity": "critical",
     "description": "Every email has a known processing status"}
  ]
}
